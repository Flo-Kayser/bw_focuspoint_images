mod.tx_bwfocuspointimages.settings {
  resizable = 1
  defaultWidth = 0.2
  defaultHeight = 0.2
  allowedShapes = rectangle

  fields {}

  shapes {
    rectangle.fields < mod.tx_bwfocuspointimages.settings.fields
    ellipse.fields < mod.tx_bwfocuspointimages.settings.fields
    line.fields < mod.tx_bwfocuspointimages.settings.fields
    crosshair.fields < mod.tx_bwfocuspointimages.settings.fields
    polygon.fields < mod.tx_bwfocuspointimages.settings.fields
  }

}

mod.wizards.newContentElement.wizardItems {
  special.removeItems := addToList(bw_focuspoint_images_svg)
}
